# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=

# SAP AI Core (LiteLLM native provider — do not change var names)
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=https://[subdomain].authentication.sap.hana.ondemand.com
AICORE_BASE_URL=https://api.ai.[region].aws.ml.hana.ondemand.com
AICORE_RESOURCE_GROUP=default

# Model selection (leave as-is for hackathon)
AICORE_LLM_MODEL=sap/anthropic--claude-4.5-haiku
AICORE_LLM_FAST_MODEL=sap/anthropic--claude-4.5-haiku

# App settings
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,https://nexora.vercel.app
